# Django
DJANGO_SETTINGS_MODULE=zooshop.settings.dev
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Development database (SQLite) — переопределите только при необходимости
DATABASE_URL=

# Production PostgreSQL (используется при DJANGO_SETTINGS_MODULE=zooshop.settings.prod)
POSTGRES_DB=zoomag_db
POSTGRES_USER=zoomag_user
POSTGRES_PASSWORD=zoomag_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Logging
DJANGO_LOG_LEVEL=INFO

# --- Docker Compose (прод-сборка локально): скопируйте блок и выставьте DJANGO_SETTINGS_MODULE=zooshop.settings.prod
# DJANGO_SETTINGS_MODULE=zooshop.settings.prod
# DEBUG=false
# SECRET_KEY=<случайная-длинная-строка>
# ALLOWED_HOSTS=*
