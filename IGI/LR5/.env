DJANGO_SETTINGS_MODULE=zooshop.settings.prod
SECRET_KEY=django-insecure-change-me-to-secure-key-in-production-12345678901234567890
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=zoomag_db
POSTGRES_USER=zoomag_user
POSTGRES_PASSWORD=zoomag_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_LOG_LEVEL=INFO

BOOTSTRAP_SUPERUSER_USERNAME=admin
BOOTSTRAP_SUPERUSER_EMAIL=admin@example.com
BOOTSTRAP_SUPERUSER_PASSWORD=admin
